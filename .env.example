# GitHub OAuth App для входа в Nuxt Studio (нужно только в продакшене)
# Callback URL: https://<ваш-домен>/__nuxt_studio/auth/github
STUDIO_GITHUB_CLIENT_ID=
STUDIO_GITHUB_CLIENT_SECRET=

# Необязательно: список email, которым разрешён вход (через запятую)
# STUDIO_GITHUB_MODERATORS=editor@company.ru

# Необязательно: AI-подсказки в редакторе (ключ Vercel AI Gateway)
# NUXT_STUDIO_AI_API_KEY=
